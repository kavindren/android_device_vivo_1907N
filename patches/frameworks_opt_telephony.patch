+    /**
+     * Bring the subscription's active state in line with its "UICC applications enabled" flag
+     * without waiting for a SIM state change.
+     *
+     * Normally the modem's answer to ENABLE_UICC_APPLICATIONS (apps go away / come back) makes
+     * the SIM state change, which re-runs {@link #updateSubscription}. The MediaTek RIL on this
+     * device acks the request but does nothing, so no such event ever arrives and the toggle in
+     * Settings only took effect on the next boot, when updateSubscription() honours the flag.
+     */
+    private void syncSubscriptionWithUiccAppsSetting(int subId) {
+        SubscriptionInfoInternal subInfo = mSubscriptionDatabaseManager
+                .getSubscriptionInfoInternal(subId);
+        if (subInfo == null || subInfo.isEmbedded()) return;
+
+        int phoneId = SubscriptionManager.INVALID_SIM_SLOT_INDEX;
+        for (int i = 0; i < mSimState.length; i++) {
+            UiccPort port = mUiccController.getUiccPort(i);
+            if (port != null && port.getIccId() != null
+                    && subInfo.getIccId().equals(IccUtils.stripTrailingFs(port.getIccId()))) {
+                phoneId = i;
+                break;
+            }
+        }
+        if (phoneId == SubscriptionManager.INVALID_SIM_SLOT_INDEX) return;
+
+        logl("syncSubscriptionWithUiccAppsSetting: subId=" + subId + ", phoneId=" + phoneId
+                + ", enabled=" + subInfo.areUiccApplicationsEnabled());
+        if (subInfo.areUiccApplicationsEnabled()) {
+            updateSubscription(phoneId);
+            // The SIM never left LOADED, so nothing re-triggers the carrier config load that
+            // MultiSimSettingController waits for ("Carrier config subId N is not loaded")
+            // before restoring the default data subscription; mobile data stayed off until
+            // the user toggled it. Do what a real SIM re-load would.
+            CarrierConfigManager configManager =
+                    mContext.getSystemService(CarrierConfigManager.class);
+            if (configManager != null) {
+                configManager.updateConfigForPhoneId(phoneId,
+                        IccCardConstants.INTENT_VALUE_ICC_LOADED);
+            }
+        } else {
+            markSubscriptionsInactive(phoneId);
+        }
+    }
