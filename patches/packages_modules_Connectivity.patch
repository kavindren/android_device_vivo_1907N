@@ -4,5 +4,12 @@ service bpfloader /apex/com.android.tethering/bin/netbpfload
     user root
     rlimit memlock 1073741824 1073741824
     oneshot
-    reboot_on_failure reboot,bpfloader-failed
+    # device/vivo/1907N: this is the APEX-bundled ("mainline") copy of the bpfloader service
+    # declaration, packaged into com.android.tethering as e.g. netbpfload.33rc - it carries
+    # `override` and gets parsed ~10s after the plain /system/etc/init/netbpfload.rc copy, so
+    # it wins and silently reintroduced reboot_on_failure even after that other file's copy of
+    # the same line was disabled (see netbpfload.rc's own comment / device git history for the
+    # full reasoning: kernel 4.14.336 has no BTF support, offload@btf.o's CO-RE map creation
+    # structurally cannot succeed here).
+    #reboot_on_failure reboot,bpfloader-failed
     override
