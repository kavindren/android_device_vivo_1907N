+    /**
+     * vivo 1907N IMS bring-up: real root cause of IMS/VoLTE never registering, traced all the
+     * way down from MtkQualifiedNetworksService's own constructor (mediatek-telephony-
+     * common.jar, byte-identical to stock): it checks `mPhone.mCi instanceof MtkRIL` and
+     * silently no-ops its whole periodic qualified-networks evaluation loop otherwise, logging
+     * just "Constructor: mPhone.mCi is not instanceof MTKRIL!" - a message nothing downstream of
+     * that class ever surfaces prominently. MtkTelephonyComponentFactory (also already in that
+     * jar) was clearly meant to inject this via overriding a makeRil() factory method, but that
+     * indirection doesn't exist in this AOSP version at all - this class constructs RIL
+     * directly, no factory call in between. MtkRIL extends RIL with an identical constructor
+     * signature (Context, int, int, Integer) to the real one, so this is a direct swap, not a
+     * port - except mediatek-telephony-common.jar is a dex_import prebuilt, which Soong
+     * explicitly forbids as a compile-time dependency of a real java_library (it "can only be
+     * installed", per build/soong/java/java.go's own comment on DexImport) - so this can't be a
+     * plain "new MtkRIL(...)" the compiler resolves normally. Falls back to real RIL if the
+     * class genuinely isn't present (e.g. building for a different, non-MTK device), so this is
+     * never a hard dependency.
+     */
+    private static CommandsInterface newRil(Context context, int preferredNetworkType,
+            int cdmaSubscription, Integer instanceId) {
+        try {
+            Class<?> mtkRilClass = Class.forName("com.mediatek.internal.telephony.MtkRIL");
+            Constructor<?> ctor = mtkRilClass.getConstructor(
+                    Context.class, int.class, int.class, Integer.class);
+            return (CommandsInterface) ctor.newInstance(
+                    context, preferredNetworkType, cdmaSubscription, instanceId);
+        } catch (ReflectiveOperationException e) {
+            Rlog.w(LOG_TAG, "MtkRIL not available, falling back to RIL: " + e);
+            return new RIL(context, preferredNetworkType, cdmaSubscription, instanceId);
+        }
+    }
+
