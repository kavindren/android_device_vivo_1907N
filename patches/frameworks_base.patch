@@ -40,6 +41,21 @@ public class FingerprintSensorPropertiesInternal extends SensorPropertiesInterna
      */
     public final @FingerprintSensorProperties.SensorType int sensorType;
 
+    // vivo's own framework build (not part of AOSP) adds these two fields to this exact class -
+    // vivo/1907N's FingerprintEngineer.apk (a factory diagnostic tool, compiled against that
+    // framework) accesses them directly via iget-object bytecode, not reflection, so it crashes
+    // with NoSuchFieldError without them regardless of what the values actually contain. Added
+    // here purely so that tool doesn't crash - nothing in this framework's own Fingerprint21/HAL
+    // stack reads or populates them with anything meaningful yet.
+    public final String moduleName = "";
+    public final String manufacturerName = "";
+    // Bitmaps FingerprintEngineer draws for its own illumination-preview UI (separate from the
+    // real capture path) and an anti-spoofing/liveness-related flag it also reads directly -
+    // same NoSuchFieldError reasoning as above; null/0 since nothing here populates them yet.
+    @Nullable public final Bitmap illuminatorBitmap = null;
+    @Nullable public final Bitmap antifakeBitmap = null;
+    public final int antifake = 0;
+
     private final List<SensorLocationInternal> mSensorLocations;
 
     public FingerprintSensorPropertiesInternal(int sensorId,
