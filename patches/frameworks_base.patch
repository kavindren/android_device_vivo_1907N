diff --git a/core/java/android/hardware/face/FaceManager.java b/core/java/android/hardware/face/FaceManager.java
index b97055976e3e..65417cfec44d 100644
--- a/core/java/android/hardware/face/FaceManager.java
+++ b/core/java/android/hardware/face/FaceManager.java
@@ -37,6 +37,7 @@ import android.os.Handler;
 import android.os.IBinder;
 import android.os.IRemoteCallback;
 import android.os.Looper;
+import android.os.ParcelFileDescriptor;
 import android.os.PowerManager;
 import android.os.RemoteException;
 import android.os.Trace;
@@ -466,6 +467,68 @@ public class FaceManager implements BiometricAuthenticator, BiometricFaceConstan
         }
     }
 
+    /**
+     * vivo 1907N Face Unlock bring-up: not an AOSP API. Allocates (or returns the existing) shared
+     * memory region the capture app should write raw camera frame bytes (tightly-packed NV21, no
+     * header) into, one frame at a time, before each {@link #sendCommand}. See the vivo 1907N
+     * Face Unlock bring-up plan for the reverse-engineered protocol this exists to support.
+     *
+     * @hide
+     */
+    @RequiresPermission(USE_BIOMETRIC_INTERNAL)
+    public ParcelFileDescriptor getShareMemoryFd(int sensorId, int size) {
+        if (mService != null) {
+            try {
+                return mService.getShareMemoryFd(sensorId, size, mContext.getOpPackageName());
+            } catch (RemoteException e) {
+                throw e.rethrowFromSystemServer();
+            }
+        }
+        return null;
+    }
+
+    /**
+     * vivo 1907N Face Unlock bring-up: not an AOSP API. Forwards a vendor-defined command to the
+     * face HAL - used by the capture app to signal that a new frame is ready in the shared memory
+     * region obtained from {@link #getShareMemoryFd}. See the vivo 1907N Face Unlock bring-up plan.
+     *
+     * @hide
+     */
+    @RequiresPermission(USE_BIOMETRIC_INTERNAL)
+    public void sendCommand(int sensorId, int cmd, int extra, String bundle) {
+        if (mService != null) {
+            try {
+                mService.sendCommand(sensorId, cmd, extra, bundle, mContext.getOpPackageName());
+            } catch (RemoteException e) {
+                throw e.rethrowFromSystemServer();
+            }
+        }
+    }
+
+    /**
+     * vivo 1907N Face Unlock bring-up: not an AOSP API. Lets the enrollment UI hand the capture
+     * app a {@link Surface} (its camera preview TextureView's) to render a live self-view into,
+     * independent of the enroll() call's own timing (the standard AOSP {@code previewSurface}
+     * parameter on {@link #enroll} is plumbed through the newer AIDL face HAL path only - this
+     * device uses the older HIDL path, where that parameter is accepted but never used - see
+     * hidl/FaceEnrollClient.java). Called from FaceEnrollPreviewFragment as soon as its
+     * TextureView's SurfaceTexture becomes available, which may be before or after enrollment
+     * actually starts. Pass {@code null} to stop rendering into a previously-set surface (e.g.
+     * when the preview fragment pauses).
+     *
+     * @hide
+     */
+    @RequiresPermission(USE_BIOMETRIC_INTERNAL)
+    public void setPreviewSurface(int sensorId, @Nullable Surface surface) {
+        if (mService != null) {
+            try {
+                mService.setPreviewSurface(sensorId, surface, mContext.getOpPackageName());
+            } catch (RemoteException e) {
+                throw e.rethrowFromSystemServer();
+            }
+        }
+    }
+
     /**
      * @hide
      */
diff --git a/core/java/android/hardware/face/IFaceService.aidl b/core/java/android/hardware/face/IFaceService.aidl
index 989b001ca8bf..d2457de60368 100644
--- a/core/java/android/hardware/face/IFaceService.aidl
+++ b/core/java/android/hardware/face/IFaceService.aidl
@@ -23,6 +23,7 @@ import android.hardware.biometrics.ITestSessionCallback;
 import android.hardware.face.IFaceServiceReceiver;
 import android.hardware.face.Face;
 import android.hardware.face.FaceSensorPropertiesInternal;
+import android.os.ParcelFileDescriptor;
 import android.view.Surface;
 
 /**
@@ -134,4 +135,20 @@ interface IFaceService {
     // AIDL sensor properties are retrieved directly from the available HALs. If no HIDL HALs exist,
     // hidlSensors must be non-null and empty. See AuthService.java
     void registerAuthenticators(in List<FaceSensorPropertiesInternal> hidlSensors);
+
+    // vivo 1907N Face Unlock bring-up: not an AOSP API. Allocates (or returns the existing) shared
+    // memory region the capture app writes raw camera frame bytes into, and hands its native handle
+    // to the vendor.vivo.hardware.biometrics.face@2.0 HAL via sendhandle() the first time this is
+    // called for a session. See device/vivo/1907N's Face Unlock bring-up plan for the full protocol.
+    ParcelFileDescriptor getShareMemoryFd(int sensorId, int size, String opPackageName);
+
+    // vivo 1907N Face Unlock bring-up: not an AOSP API. Forwards a vendor-defined command to the
+    // vendor.vivo.hardware.biometrics.face@2.0 HAL's sendCommand(). Used by the capture app to signal
+    // "a new frame is ready in the shared memory region from getShareMemoryFd()" once per frame.
+    void sendCommand(int sensorId, int cmd, int extra, String bundle, String opPackageName);
+
+    // vivo 1907N Face Unlock bring-up: not an AOSP API. Hands the capture app a Surface to render
+    // a live self-view preview into (see FaceManager.setPreviewSurface() for the full rationale).
+    // Pass null to stop rendering into a previously-set surface.
+    void setPreviewSurface(int sensorId, in Surface surface, String opPackageName);
 }
