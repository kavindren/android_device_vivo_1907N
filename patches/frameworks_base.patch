+package com.android.systemui.biometrics;
+
+import android.annotation.Nullable;
+import android.content.Context;
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.view.Surface;
+
+/**
+ * vivo 1907N (Goodix gf9518) UDFPS local illumination.
+ *
+ * Stock Funtouch draws a solid bright circle exactly over the sensor via its own
+ * FingerprintUI.apk. AOSP's {@link UdfpsView} already draws that same circle -
+ * {@code drawIlluminationDot()} in {@code UdfpsSurfaceView} - but only when
+ * {@code config_udfpsHbmType} is {@link UdfpsHbmTypes#GLOBAL_HBM}; with the stock LineageOS
+ * default of {@link UdfpsHbmTypes#LOCAL_HBM} plus {@link DummyUdfpsHbmProvider}, nothing is ever
+ * drawn at all. This provider exists to flip that switch (see the device's
+ * SystemUI/res/values/lineage_config.xml overlay) so the sensor images a bright, known-color
+ * circle instead of whatever the underlying app content happens to be at that spot.
+ *
+ * 2026-08-30 correction: an earlier version of this class removed the raw panel-level HBM boost
+ * below, on the theory that it was a no-op - stock never triggers it from an init trigger, and
+ * the kernel's oled_hbm_store() only has one real "on" level, so there was nothing to "tune".
+ * That reasoning conflated two different things: stock DOES write this sysfs node for real, just
+ * from its own FingerprintUI.apk at touch time (app-domain), not from init at boot - the "only
+ * one on-level" fact just means there's no brightness curve to pick a better value from, not
+ * that writing "4" does nothing. The write itself is a genuine backlight-boost side effect on
+ * top of (not a substitute for) the drawn circle's color, and skipping it left the illumination
+ * area only tinted at normal brightness instead of actually lit - confirmed visually on-device
+ * (color-only, no real illumination). Restored, wired the same way as before: SystemUI can't
+ * write a vendor sysfs node directly (Treble boundary), so this goes through the same
+ * vendor.udfps.hbm_state property bridge to vendor init (see
+ * device/vivo/1907N/rootdir/etc/init.udfps-hbm.rc) that stock's own app-domain access
+ * conceptually mirrors.
+ */
+public class Vivo1907NUdfpsHbmProvider implements UdfpsHbmProvider {
+
+    private static final String UDFPS_HBM_PROP = "vendor.udfps.hbm_state";
+
+    // The vendor gf9518 daemon auto-reverts panel HBM ~85ms after a single "4" write (confirmed
+    // via dmesg: OverlayEngine_0's lcm_set_hbm_cmdq reverting hbm=4->5 on its own timer,
+    // unrelated to the app), but a real image capture takes ~150ms. This alternates two distinct
+    // "on" property values (both wired to "write 4" in init.udfps-hbm.rc) to keep re-arming it
+    // for as long as the illumination dot needs to stay lit, since property triggers only fire
+    // on a real value transition, not a redundant re-set to the same value.
+    private static final long HBM_KEEPALIVE_INTERVAL_MS = 50;
+    private volatile boolean mKeepAliveActive;
+
+    public Vivo1907NUdfpsHbmProvider(Context context) {
+    }
+
+    @Override
+    public void enableHbm(int hbmType, @Nullable Surface surface,
+            @Nullable Runnable onHbmEnabled) {
+        mKeepAliveActive = true;
+        new Thread(() -> {
+            boolean toggle = false;
+            while (mKeepAliveActive) {
+                SystemProperties.set(UDFPS_HBM_PROP, toggle ? "2" : "1");
+                toggle = !toggle;
+                SystemClock.sleep(HBM_KEEPALIVE_INTERVAL_MS);
+            }
+        }, "Vivo1907NUdfpsHbmKeepAlive").start();
+
+        if (onHbmEnabled != null) {
+            onHbmEnabled.run();
+        }
+    }
+
+    @Override
+    public void disableHbm(@Nullable Runnable onHbmDisabled) {
+        mKeepAliveActive = false;
+        SystemProperties.set(UDFPS_HBM_PROP, "0");
+
+        if (onHbmDisabled != null) {
+            onHbmDisabled.run();
+        }
+    }
+}
