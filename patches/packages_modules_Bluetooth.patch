   void read_default_erroneous_data_reporting_handler(CommandCompleteView view) {
-    ASSERT(view.GetCommandOpCode() == OpCode::READ_DEFAULT_ERRONEOUS_DATA_REPORTING);
+    // device/vivo/1907N: the ASSERT(view.GetCommandOpCode() == ...) that used to be here hit
+    // the exact same "claims to support it but doesn't" case the comment below already
+    // documents (b/277589118) - confirmed via a real device: this controller replies to
+    // READ_DEFAULT_ERRONEOUS_DATA_REPORTING with a COMMAND_STATUS(UNKNOWN_HCI_COMMAND) instead
+    // of COMMAND_COMPLETE, which hci_layer.cc's handle_command_response() (since opcode 0xc5a
+    // isn't vendor-specific, so its own graceful-UNKNOWN_HCI_COMMAND path doesn't apply) turns
+    // into a synthesized EMPTY CommandCompleteView fallback. Google's own fix one line below
+    // already avoids this exact problem for IsValid() ("not used here to avoid process abort")
+    // but missed this identical case for the opcode check.
+    //
+    // First attempt at this fix (a plain if() instead of ASSERT() around GetCommandOpCode())
+    // was still not enough and still aborted, confirmed via a second real-device tombstone:
+    // every generated PacketView's field getters - GetCommandOpCode() included - assert
+    // was_validated_ internally (packet/parser/*.cc's codegen), regardless of whether the
+    // *caller* wraps the result in an ASSERT or a plain if. IsValid() is the one method that's
+    // actually safe to call before that internal flag is set (it's what sets it) - matching
+    // the "not used here to avoid process abort" comment below, which relies on the same
+    // property. Checking that first here avoids ever calling GetCommandOpCode() on the
+    // synthesized empty packet at all.
+    if (!view.IsValid() || view.GetCommandOpCode() != OpCode::READ_DEFAULT_ERRONEOUS_DATA_REPORTING) {
+      LOG_ERROR("invalid or unexpected opcode in command complete view");
+      return;
+    }
     auto complete_view = ReadDefaultErroneousDataReportingCompleteView::Create(view);
     // Check to see that the opcode was correct.
     // ASSERT(complete_view.IsValid()) is not used here to avoid process abort.
