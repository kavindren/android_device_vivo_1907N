+void RecoveryUI::RestoreBrightness() {
+  if (screensaver_state_ == ScreensaverState::DISABLED) {
+    return;
+  }
+  // gr_init()'s FB_BLANK cycle powers the panel backlight down through the display path, behind
+  // the LED class driver's back. The driver still caches the pre-blank level and no-ops a write
+  // of that same value ("no level change, do nothing"), so re-writing the normal level alone
+  // does nothing. Force a real update by poking a different level first.
+  android::base::WriteStringToFile("0", brightness_file_);
+  SetScreensaverState(ScreensaverState::NORMAL);
+}
