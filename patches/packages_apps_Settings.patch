new file mode 100644
index 0000000000..6f2caabd69
--- /dev/null
+++ b/src/com/android/settings/biometrics/face/FaceEducationAnimationDrawable.java
@@ -0,0 +1,126 @@
+/*
+ * vivo 1907N Face Unlock bring-up (not AOSP).
+ *
+ * The "how Face Unlock works" screen (FaceEnrollEducation) is supposed to show an animated
+ * illustration, but neither of AOSP's own two options actually has real content in this open
+ * source tree: res/raw/face_education.mp4 fails to play on this device (a genuine low-level
+ * MediaPlayer/mediaserver error, "MediaPlayer error (1, -2147483648)", confirmed via a real
+ * device log - not something worth chasing blind on a from-scratch device tree), and its
+ * supposed Lottie fallback (res/raw/face_education_lottie.json) turned out to be a 0-byte empty
+ * file - the same kind of unfinished AOSP placeholder as the empty strings this device tree
+ * already had to fill in elsewhere (see FaceEnrollIntroduction's string overlay). Google's real
+ * Pixel-specific assets for this screen were evidently never open-sourced, same story as those
+ * strings.
+ *
+ * This draws a real, working alternative instead: the static face icon AOSP already ships and
+ * uses correctly elsewhere on this same screen (R.drawable.face_enroll_icon_large, used for the
+ * accessibility variant of this illustration) plus the same animated "particle" dots already
+ * used successfully on the enrolling screen (ParticleCollection, see
+ * FaceEnrollAnimationDrawable) - reusing a working, already-in-tree visual language instead of
+ * inventing a new one from scratch or hand-authoring Lottie/video content blind.
+ */
+package com.android.settings.biometrics.face;
+
+import android.animation.TimeAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.drawable.Drawable;
+
+import com.android.settings.R;
+
+public class FaceEducationAnimationDrawable extends Drawable {
+
+    // Matches FaceEnrollAnimationDrawable's own BORDER_BOUNDS - keeps the particle ring's visual
+    // proportions consistent between the education and enrolling screens.
+    private static final int BORDER_BOUNDS = 20;
+
+    private final Context mContext;
+    private final Drawable mFaceIcon;
+    private ParticleCollection mParticleCollection;
+    private TimeAnimator mTimeAnimator;
+    private Rect mBounds;
+
+    public FaceEducationAnimationDrawable(Context context) {
+        mContext = context;
+        mFaceIcon = context.getDrawable(R.drawable.face_enroll_icon_large).mutate();
+    }
+
+    @Override
+    protected void onBoundsChange(Rect bounds) {
+        mBounds = bounds;
+
+        // Centered square, leaving room for the particle ring around it - matches how
+        // face_enroll_icon_large is already sized/positioned for the accessibility variant of
+        // this same screen (FaceEnrollEducation's illustration_accessibility ImageView, plain
+        // wrap_content + center gravity over the same overall bounds).
+        final int iconSize = Math.min(bounds.width(), bounds.height()) - BORDER_BOUNDS * 4;
+        final int left = bounds.left + (bounds.width() - iconSize) / 2;
+        final int top = bounds.top + (bounds.height() - iconSize) / 2;
+        mFaceIcon.setBounds(left, top, left + iconSize, top + iconSize);
+
+        // AnimationParticle.drawDot() computes independent x/y orbit radii from whatever Rect
+        // it's given (w = bounds.right-centerX-border, h = bounds.bottom-centerY-border) -
+        // that's only a circle if bounds is square. On the real enrolling screen
+        // (FaceEnrollAnimationDrawable) that holds because its host view (FaceSquareTextureView)
+        // is forced square in onMeasure(); this screen's host ImageView
+        // (face_enroll_education.xml's illustration_accessibility) is match_parent width x
+        // wrap_content height, not square, so passing `bounds` straight through drew flattened,
+        // egg-shaped orbits instead of circles (confirmed on-device). Same fix shape as the icon
+        // sizing above: a centered square sub-rect instead of the raw (non-square) bounds.
+        final int ringSize = Math.min(bounds.width(), bounds.height());
+        final int ringLeft = bounds.left + (bounds.width() - ringSize) / 2;
+        final int ringTop = bounds.top + (bounds.height() - ringSize) / 2;
+        final Rect ringBounds =
+                new Rect(ringLeft, ringTop, ringLeft + ringSize, ringTop + ringSize);
+
+        // No-op listener - this is a looping preview animation on a tutorial screen, not a real
+        // enrollment session, so there's no "enrolled" event to react to here.
+        mParticleCollection = new ParticleCollection(mContext, () -> { }, ringBounds,
+                BORDER_BOUNDS);
+
+        if (mTimeAnimator == null) {
+            mTimeAnimator = new TimeAnimator();
+            mTimeAnimator.setTimeListener((animation, totalTimeMs, deltaTimeMs) -> {
+                mParticleCollection.update(totalTimeMs, deltaTimeMs);
+                invalidateSelf();
+            });
+            mTimeAnimator.start();
+        }
+    }
+
+    @Override
+    public void draw(Canvas canvas) {
+        if (mBounds == null) {
+            return;
+        }
+        mFaceIcon.draw(canvas);
+        mParticleCollection.draw(canvas);
+    }
+
+    /** Stops the looping animation - call from the hosting Activity/Fragment's onDestroy() to
+     *  avoid leaking the TimeAnimator. */
+    public void stop() {
+        if (mTimeAnimator != null) {
+            mTimeAnimator.cancel();
+            mTimeAnimator = null;
+        }
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        mFaceIcon.setAlpha(alpha);
+    }
+
+    @Override
+    public void setColorFilter(ColorFilter colorFilter) {
+        mFaceIcon.setColorFilter(colorFilter);
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+}
