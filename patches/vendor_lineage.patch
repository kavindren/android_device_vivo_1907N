--- a/config/BoardConfigKernel.mk
+++ b/config/BoardConfigKernel.mk
@@ -165,6 +165,11 @@ ifneq ($(KERNEL_NO_GCC), true)
     endif
 
     KERNEL_MAKE_FLAGS += CPATH="/usr/include:/usr/include/x86_64-linux-gnu" HOSTLDFLAGS="-L/usr/lib/x86_64-linux-gnu -L/usr/lib64 -fuse-ld=lld"
+    # scripts/Makefile.host's cmd_host-csingle (fixdep et al.) doesn't use HOSTLDFLAGS at
+    # all - only host-cmulti/host-cshlib do - so a clang toolchain with no bundled bfd `ld`
