+    # HOSTCFLAGS instead. 1907N-specific; see los-1907N/vivo BoardConfig.mk notes.
+    KERNEL_MAKE_FLAGS += HOSTCFLAGS="-fuse-ld=lld"
 
     ifeq ($(KERNEL_ARCH),arm64)
