type vts_app, domain;
init_daemon_domain(vts_app)

allow vts_app vivo_tpfs:dir r_dir_perms;
allow vts_app vivo_tpfs:file rw_file_perms;
allow vts_app vts_fs:dir r_dir_perms;
allow vts_app vts_fs:file rw_file_perms;
allow vts_app mvts_device:chr_file rw_file_perms;
allow vts_app vendor_data_file:dir create_dir_perms;
allow vts_app vendor_data_file:file create_file_perms;
allow vts_app touchscreen_private_file:dir create_dir_perms;
allow vts_app touchscreen_private_file:file create_file_perms;

# Focaltech (fts_i2c / fts_i2c_second)
allow vts_app sysfs_ftm:dir r_dir_perms;
allow vts_app sysfs_ftm:file rw_file_perms;

# Samsung-style touch IC (sec_ts / sec_ts_vivo)
allow vts_app sysfs_sec:dir r_dir_perms;
allow vts_app sysfs_sec:file rw_file_perms;
allow vts_app sysfs_sec_tsp:dir r_dir_perms;
allow vts_app sysfs_sec_tsp:file rw_file_perms;

allow vts_app gtp_tools_device:chr_file rw_file_perms;
allow vts_app tcm0_device:chr_file rw_file_perms;

allow vts_app ilitek_ioctl:chr_file rw_file_perms;
allow vts_app st_test_device:chr_file rw_file_perms;
allow vts_app cts_tool:chr_file rw_file_perms;

allow vts_app proc:file r_file_perms;
