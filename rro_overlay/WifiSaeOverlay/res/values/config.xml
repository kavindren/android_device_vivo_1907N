         answered the association with status 31 (robust management frame policy violation) and
         the network stayed disabled ("phone stopped connecting to Wi-Fi"). Keep such networks on
         WPA2-PSK. -->
    <bool name="config_wifiSaeUpgradeEnabled">false</bool>
