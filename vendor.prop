# Display & SurfaceFlinger
ro.sf.lcd_density=480
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# Storage & FBE Encryption
# ro.crypto.* used to be hardcoded here to match forced FBE - now that fileencryption= is
# removed from rootdir/etc/fstab.mt6768's /data line, these would just be wrong/contradictory
# static values (ro.crypto.state=encrypted while /data actually isn't). vold derives and sets
# the real ro.crypto.* properties itself at runtime based on what the fstab actually says, so
# they don't need to be (and shouldn't be) hardcoded here at all.
ro.hardware.gatekeeper=trustonic
ro.vendor.mtk_f2fs_enable=1

# vivo/BBK identity properties (from stock vendor/build.prop) - vts_app (touchscreen firmware
# updater) reads ro.vendor.vivo.product.model directly to build the firmware filename it looks
# up under /vendor/firmware/ (e.g. "TP-FW-PD1913F_EX-LCMID33-...bin" - confirmed via strings on
# the binary: "no firmware for product:%s, pannel id = %s, type = %d"). This property was never
# carried over into this device tree's vendor.prop (only the wrong-name, wrong-partition
# ro.vivo.product.model made it into system.prop), so vts_app was looking up an empty-product
# filename that never matches any of the extracted firmware blobs, silently failing to flash
# touch firmware - the input device it's supposed to create never gets built. The rest of this
# block wasn't confirmed as a hard requirement by any single binary the way product.model was,
# but they're free (static identity strings, zero functional risk) and match stock exactly, so
# included in case other vivo HALs (bbkts, biometrics, etc.) read them too.
ro.vendor.vivo.product.model=PD1913F_EX
ro.vendor.vivo.hardware.version=PD1913F_EXMA
ro.vendor.vivo.product.overseas=yes
ro.vendor.vivo.product.platform=MTK6768
ro.vendor.vivo.product.solution=MTK
ro.vendor.vivo.product.version=PD1913F_EX_A_9.9.39

# ro.vendor.rc - stock vendor/build.prop sets this to "/vendor/etc/init/hw/" and vivo's own
# vendor/etc/init/hw/init.mt6768.rc uses it as a path-prefix variable in seven `import
# ${ro.vendor.rc}...` lines (init.connectivity.rc, init.mt6768.usb.rc, init.volte.rc,
# init.mal.rc, init.sensor_1_0.rc, init.ago.rc, init.modem.rc). Property expansion in init
# import statements is resolved at parse time against whatever's already in the static property
# space (default.prop/build.prop), so this has to be a plain build.prop value, not something set
# by an action. Never carried over into this device tree, so on this build every one of those
# imports silently expands to a bare relative filename (e.g. "init.mt6768.usb.rc") instead of an
# absolute path - Android init rejects relative import paths, so none of those seven files ever
# load. For USB specifically this means sys.usb.configfs never gets set to 1, so neither vivo's
# own init.mt6768.usb.rc gadget state machine NOR platform's init.usb.configfs.rc (which is also
# gated on sys.usb.configfs=1) ever touch /config/usb_gadget/g1 - UsbDeviceManager sets
# sys.usb.config once at boot and nothing in the whole init graph reacts to it, so the gadget's
# UDC is never bound and the phone never actually presents as a USB device (matches the endless
# MUSB connect/disconnect cycling in dmesg, and the total absence of any configfs/gadget/UDC/ffs
# logcat output, exactly). Confirmed by diffing against the mounted stock vendor/build.prop.
ro.vendor.rc=/vendor/etc/init/hw/

# ro.vendor.vivo.support.cdrom - also missing, also copied verbatim from stock vendor/build.prop.
# Once ro.vendor.rc above lets init.mt6768.usb.rc actually load, nearly every one of its
# sys.usb.config transitions (adb/mtp/ptp/mass_storage/bicr, in both plain and combined-with-adb
# forms) is additionally gated on this property being exactly "0" or "1" - undefined matches
# neither branch, so idVendor/idProduct/UDC never get written for any of those configs even with
# the import fixed.
ro.vendor.vivo.support.cdrom=0

# ro.vendor.mtk_ril_mode / ro.vendor.mtk_rild_read_imsi - missing, copied verbatim from stock
# vendor/build.prop. libmtk-ril.so reads both directly (confirmed via strings on the .so) to pick
# its SIM/RIL configuration mode.
ro.vendor.mtk_ril_mode=c6m_1rild
ro.vendor.mtk_rild_read_imsi=1

# ro.vendor.mtk_protocol1_rat_config - missing, copied verbatim from stock vendor/build.prop
# (maps to SELinux type vendor_mtk_rat_config_prop, confirmed against stock's own
# vendor_property_contexts). This is the actual root cause of no-IMEI/Baseband "Unknown":
# vendor/etc/init/mtkrild.rc's real RIL daemon (vendor.ril-daemon-mtk, /vendor/bin/hw/
# mtkfusionrild) is never started directly by any rc trigger or by ccci_mdinit - it depends on
# vendor/bin/gsm0710muxd (started by ccci_mdinit's own internal ctl.start once the modem is up,
# confirmed via logcat) to set vendor.ril.mtk=1, which is what actually fires mtkrild.rc's
# "on property:vendor.ril.mtk=1 -> start vendor.ril-daemon-mtk". gsm0710muxd's own binary
# references ro.vendor.mtk_protocol1_rat_config by string, and without it, logcat showed
# gsm0710muxd reading it (AVC audit denial in permissive mode - the property simply doesn't
# exist), then exiting cleanly (status 0) after only 0.047s without ever setting vendor.ril.mtk -
# it never gets far enough to determine what muxing/RAT setup it needs to do. The
# vold.decrypt=trigger_restart_framework trigger in mtkrild.rc (chased earlier) turned out to be
# a red herring: confirmed via system/vold/cryptfs.cpp that this property is only ever set from
# the legacy FDE (full-disk crypto footer) code path, which modern FBE devices - including this
# one, even after restoring fileencryption= in fstab.mt6768 - never execute at all.
ro.vendor.mtk_protocol1_rat_config=C/Lf/Lt/W/T/G
