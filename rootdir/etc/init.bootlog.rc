# TEMP diagnostic (LOS21 bring-up): boot animation never even shows, device just hangs on
# real hardware, and neither /proc/last_kmsg nor /sys/fs/pstore reliably capture a clean
# userspace-side hang (see los-1907N-aee-expdb-diagnostics session memory for the LOS20
# precedent of this same class of problem).
# /cache is a real, separately-mounted partition here (fstab.mt6768), mounted in first-stage
# init well before /data, and survives a reboot - so write continuously to it instead of
# relying on adb/logcat catching up before the hang.
#
# Both started from post-fs, not post-fs-data: the stock system/etc/init/hw/init.rc's own
# post-fs-data action block contains a SYNCHRONOUS `exec - system system -- /system/bin/vdc
# keymaster earlyBootEnded`, which blocks the entire merged post-fs-data trigger queue (across
# every parsed rc file, not just the main one) whenever keymaster can't register - which is
# exactly the LOS21 TEE/keymaster crash-loop bring-up bug this diagnostic exists to chase (see
# los-1907N-los20-port session memory). A start command queued behind that exec, like our own
# original `on post-fs-data: start logcat_to_cache`, simply never runs, leaving
# /cache/bootlog/logcat.log missing entirely rather than just incomplete. logd doesn't need
# /data (only /dev sockets), and is already alive by post-fs (confirmed via logd.auditd
# messages in dmesg as early as ~5.1s), so logcat works fine started this early too.
on post-fs
    mkdir /cache/bootlog 0755 root root
    start dmesg_to_cache
    start logcat_to_cache

service dmesg_to_cache /system/bin/sh -c "exec dmesg -w >> /cache/bootlog/dmesg.log 2>&1"
    class core
    user root
    group root log
    seclabel u:r:su:s0
    disabled
    oneshot

service logcat_to_cache /system/bin/logcat -b all -v threadtime -f /cache/bootlog/logcat.log
    class core
    user root
    group root log
    seclabel u:r:su:s0
    disabled
