# mount_point    fstype    device                               flags
/system          ext4      /dev/block/platform/bootdevice/by-name/system     flags=display="System";backup=1
/vendor          ext4      /dev/block/platform/bootdevice/by-name/vendor     flags=display="Vendor";backup=1
/data            ext4      /dev/block/platform/bootdevice/by-name/userdata   flags=fileencryption=aes-256-xts:aes-256-cts:v1
/cache           ext4      /dev/block/platform/bootdevice/by-name/cache      flags=display="Cache"
/metadata        ext4      /dev/block/platform/bootdevice/by-name/metadata   flags=display="Metadata"
/boot            emmc      /dev/block/platform/bootdevice/by-name/boot       flags=display="Boot";backup=1;flashimg=1
/recovery        emmc      /dev/block/platform/bootdevice/by-name/recovery   flags=display="Recovery";backup=1;flashimg=1
/dtbo            emmc      /dev/block/platform/bootdevice/by-name/dtbo       flags=display="DTBO";backup=1;flashimg=1
/vbmeta          emmc      /dev/block/platform/bootdevice/by-name/vbmeta     flags=display="VBMeta";backup=1;flashimg=1

/nvram           emmc      /dev/block/platform/bootdevice/by-name/nvram      flags=display="NVRAM";backup=1
/nvdata          ext4      /dev/block/platform/bootdevice/by-name/nvdata     flags=display="NVData";backup=1;subpartitionof=/nvram
/mnt/vendor/persist  ext4      /dev/block/platform/bootdevice/by-name/persist   flags=display="Persist";backup=1

/external_sd     auto      /dev/block/mmcblk1p1                              flags=display="MicroSD";storage;wipeui;removable
/usb_otg         auto      /dev/block/sda1                                   flags=display="USB-OTG";storage;wipeui;removable
