/system_root    ext4    /dev/block/by-name/system         flags=display="System";backup=1;mounttodecrypt
/vendor         ext4    /dev/block/by-name/vendor         flags=display="Vendor";backup=1;mounttodecrypt
/cust           ext4    /dev/block/by-name/cust           flags=display="Cust";backup=1
/persist        ext4    /dev/block/by-name/persist        flags=display="Persist";backup=1

/nvram          emmc    /dev/block/by-name/nvram          flags=display="NVRAM";backup=1;flashimg=1
/nvdata         ext4    /dev/block/by-name/nvdata         flags=display="NVData";backup=1;subpartitionof=/nvram
/nvcfg          ext4    /dev/block/by-name/nvcfg          flags=display="NVConfig";backup=1;subpartitionof=/nvram
/protect_f      ext4    /dev/block/by-name/protect1       flags=display="Protect_F";backup=1;subpartitionof=/nvram
/protect_s      ext4    /dev/block/by-name/protect2       flags=display="Protect_S";backup=1;subpartitionof=/nvram

/boot           emmc    /dev/block/by-name/boot           flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/by-name/recovery       flags=display="Recovery";backup=1;flashimg=1
/logo           emmc    /dev/block/by-name/logo           flags=display="Logo";backup=1;flashimg=1
/dtbo           emmc    /dev/block/by-name/dtbo           flags=display="DTBO";backup=1;flashimg=1
/vbmeta         emmc    /dev/block/by-name/vbmeta         flags=display="VBMeta";backup=1;flashimg=1

/tee1           emmc    /dev/block/by-name/tee1           flags=display="TEE 1";backup=1
/tee2           emmc    /dev/block/by-name/tee2           flags=display="TEE 2";backup=1

/persistent     emmc    /dev/block/by-name/frp            flags=display="FRP";backup=1
/metadata       ext4    /dev/block/by-name/metadata       flags=display="Metadata"
