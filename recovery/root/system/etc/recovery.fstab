# device                                          mount_point         fstype  mount_flags                              fs_mgr_flags
/dev/block/platform/bootdevice/by-name/system     /system_root        ext4    ro                                       wait
/dev/block/platform/bootdevice/by-name/vendor     /vendor             ext4    ro                                       wait
/dev/block/platform/bootdevice/by-name/userdata   /data               ext4    noatime,nosuid,nodev,discard,inlinecrypt wait,check,formattable,quota,fileencryption=aes-256-xts:aes-256-cts:v1
/dev/block/platform/bootdevice/by-name/cache      /cache              ext4    noatime,nosuid,nodev,discard             wait,check,formattable
/dev/block/platform/bootdevice/by-name/cust       /oem                ext4    ro                                       wait
/dev/block/platform/bootdevice/by-name/persist    /mnt/vendor/persist ext4    noatime,nosuid,nodev                     wait,check,formattable
