# vivo 1907N — LineageOS recovery fstab. No crypto flags (recovery never decrypts /data), no
# first_stage_mount, no check/e2fsck. /boot and /recovery are declared (emmc) only so
# ota_from_target_files can size and write them; recovery does not mount them.
# device                                          mount_point  fstype  mount_flags                   fs_mgr_flags
/dev/block/platform/bootdevice/by-name/system     /system      ext4    ro                            wait
/dev/block/platform/bootdevice/by-name/vendor     /vendor      ext4    ro                            wait
/dev/block/platform/bootdevice/by-name/cust       /oem         ext4    ro                            wait
/dev/block/platform/bootdevice/by-name/cache      /cache       ext4    noatime,nosuid,nodev,discard  wait,formattable
/dev/block/platform/bootdevice/by-name/userdata   /data        ext4    noatime,nosuid,nodev,discard  wait,formattable
/dev/block/platform/bootdevice/by-name/misc       /misc        emmc    defaults                      defaults
/dev/block/platform/bootdevice/by-name/boot       /boot        emmc    defaults                      defaults
/dev/block/platform/bootdevice/by-name/recovery   /recovery    emmc    defaults                      defaults
