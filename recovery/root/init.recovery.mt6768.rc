# vivo 1907N — LineageOS recovery device init.
# Imported by bootable/recovery/etc/init.rc via `import /init.recovery.${ro.hardware}.rc`.
# Minimal, LOS-only: no TWRP builtins, no blocking execs.

on early-init
    # MTK musb-hdrc gadget stays inert until this is 1.
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    # Cap the request_firmware() user-helper timeout: a missing fw otherwise blocks the
    # driver probe for 60s each. Touch/connsys firmware is shipped in recovery/root/vendor/
    # firmware/, this is just belt-and-braces.
    write /sys/class/firmware/timeout 5

on init
    # bootable/recovery/etc/init.rc:13 forces sys.usb.configfs=0 in early-init; restore for
    # this configfs-only target (musb-hdrc, no /sys/class/android_usb) before `on fs`.
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1

on boot
    write /sys/class/udc/musb-hdrc/device/cmode 2
    write /sys/class/leds/lcd-backlight/brightness 1000
    write /sys/class/leds/lcd-backlight/trigger backlight
