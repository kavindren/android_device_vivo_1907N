# Device Identification
ro.product.manufacturer=vivo
ro.product.brand=vivo
ro.product.model=vivo 1907
ro.product.device=1907N

# Vivo / BBK Asserts
ro.vivo.product.model=PD1913F_EX
ro.vivo.hardware.version=PD1913F_EXMA
ro.hardware.bbk=PD1913F_EXMA

ro.vivo.product.overseas=yes
ro.build.oem.projects=PD1913F_EX

# bspservice verifyOEM compares this against the RPMB "customize" seed field; without it
# ro.vendor.seed.customize.passed stays "no" and the Goodix fingerprint TA cannot unseal its
# storage. Also re-derived early by init.vivo-defend.rc. Value from a stock getprop on this unit.
ro.vivo.oem.name=PD1913F_EX_RU_NULL_NULL
ro.vivo.oem.support=yes

ro.product.model.bbk=PD1913F_EX

# Debugging
ro.debuggable=1

# USB ConfigFS & MediaTek Controller
sys.usb.controller=musb-hdrc
sys.usb.configfs=1
vendor.usb.vid=0x2D95
ro.vendor.usb.vid=0x2D95
ro.vendor.usb.pid.adb=0x6001
ro.vendor.usb.pid.mtp=0x6012
ro.vendor.usb.pid.mtp_adb=0x6013

persist.vivo.support.dualwifi=yes

ro.telephony.default_network=9,9

persist.vendor.wfc.sys_wfc_support=1
persist.vendor.volte_support=1
persist.vendor.mtk_wfc_support=1
persist.vendor.vilte_support=0
persist.vendor.viwifi_support=0

persist.vendor.ims_support=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=0
persist.dbg.wfc_avail_ovr=1
persist.dbg.allow_ims_off=1

persist.vendor.mtk.volte.enable=1
persist.vendor.mtk_dynamic_ims_switch=1
persist.vendor.mims_support=2
persist.vendor.mtk_ct_volte_support=3
ro.telephony.iwlan_operation_mode=default

vendor.ril.imsconfig.force.notify=1

persist.mtk_epdg_support=1

ro.vendor.md_auto_setup_ims=1

bluetooth.device.class_of_device=90,2,12
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bap.broadcast.assist.enabled=true
bluetooth.profile.bap.unicast.client.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.csip.set_coordinator.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hap.client.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.mcp.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.ccp.server.enabled=true
bluetooth.profile.vcp.controller.enabled=true

# Self-hosted OTA (LineageOS Updater). Overrides the built-in updater_server_url. Placeholders:
# {device}=ro.lineage.device, {type}=ro.lineage.releasetype (lowercased), {incr}=ro.build.version.incremental.
# The 19.1 Updater reads "lineage.updater.uri" (Constants.PROP_UPDATER_URI), NOT "ro.updater.uri".
# Set to your own host before building; see tools/ota/.
lineage.updater.uri=https://95.165.95.207.sslip.io/api/v1/{device}/{type}/{incr}

# Reported to PackageManager as reqGlEsVersion / used by Google Play's compatibility filter.
# It was unset (reqGlEsVersion=0x0), so Play treated the device as having no OpenGL ES and hid
# or refused apps that require it (Firefox not found, Android Auto "not supported"). The
# Mali-G52 reports OpenGL ES 3.2 -> 0x00030002 = 196610.
ro.opengles.version=196610
