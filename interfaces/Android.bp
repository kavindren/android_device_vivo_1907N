// vivo 1907N vendor HIDL interfaces.
//
// These are reverse-engineered from stock Funtouch's vendor.vivo.hardware.biometrics.*
// interface libraries (method signatures recovered from the BpHw*/BnHw* symbol tables of
// vendor.vivo.hardware.biometrics.face@2.0.so and .fingerprint@3.0.so). The out-of-tree
// frameworks/base Face Unlock + UDFPS patches depend on the generated -java stubs.

hidl_package_root {
    name: "vendor.vivo.hardware",
    path: "device/vivo/1907N/interfaces",
}
