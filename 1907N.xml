<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    LineageOS 19.1 local manifest for the vivo V17 Neo (1907N / PD1913F_EX).
    Copy to .repo/local_manifests/1907N.xml, then `repo sync`.
  -->
  <!-- remote "github" is already defined by LineageOS's own default.xml (fetch=".."
       resolves to https://github.com/), reused here - redefining it makes repo init
       fail with "remote github already exists with different attributes". -->
  <project name="kavindren/android_device_vivo_1907N"
           path="device/vivo/1907N"
           remote="github" revision="lineage-19.1" />

  <project name="kavindren/android_vendor_vivo_1907N"
           path="vendor/vivo/1907N"
           remote="github" revision="lineage-19.1" />

  <!-- Kernel: 4.14.336 merge branch. master is pinned at d27b3c4e8.
       sync-s: pull the KernelSU-Next submodule (drivers/kernelsu -> ../KernelSU-Next/kernel);
       without it `make pd1913f_defconfig` dies on "can't open drivers/kernelsu/Kconfig". -->
  <project name="kavindren/android_kernel_vivo_pd1913f"
           path="kernel/vivo/1907N"
           remote="github" revision="stable-merge-414336"
           sync-s="true" />

  <!--
    Common MediaTek SELinux policy pulled in by device/vivo/1907N/BoardConfig.mk.
    LineageOS's own android_device_mediatek_sepolicy_vndr only has branches from
    lineage-20 onward; for lineage-19.1 (Android 12) MT6768 device trees the
    community convention (used by Redmi-MT6768's merlinx/lava/mt6768-common
    lineage-19.1 trees) is to pull the StatiXOS fork's "sc" branch instead.
  -->
  <remote name="statix" fetch="https://github.com/StatiXOS" />
  <project path="device/mediatek/sepolicy_vndr"
           name="android_device_mediatek_sepolicy_vndr"
           remote="statix"
           revision="sc" />
</manifest>
