<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    LineageOS 21 local manifest for the vivo V17 Neo (1907N / PD1913F_EX).
    Copy to .repo/local_manifests/1907N.xml, then `repo sync`.

    Manifest superproject branch is "lineage-21.0" (repo init -b lineage-21.0) - note the
    ".0", unlike most component repos below which just use "lineage-21".

    Ported from LOS 20 (see git history for that manifest's own comments/rationale on the
    kernel choice and the sepolicy_vndr fork situation). Kernel stays 4.14.336 again - no
    GKI requirement blocks a legacy kernel on an unofficial/uncertified build, only Google's
    own CDD/GMS certification for official device launches cares about that.
  -->
  <!-- remote "github" is already defined by LineageOS's own default.xml (fetch=".."
       resolves to https://github.com/), reused here - redefining it makes repo init
       fail with "remote github already exists with different attributes". -->
  <project name="kavindren/android_device_vivo_1907N"
           path="device/vivo/1907N"
           remote="github" revision="lineage-21" />

  <project name="kavindren/android_vendor_vivo_1907N"
           path="vendor/vivo/1907N"
           remote="github" revision="lineage-21" />

  <!-- sync-s: pull the KernelSU-Next submodule (drivers/kernelsu -> ../KernelSU-Next/kernel);
       without it `make pd1913f_defconfig` dies on "can't open drivers/kernelsu/Kconfig". -->
  <project name="kavindren/android_kernel_vivo_pd1913f"
           path="kernel/vivo/1907N"
           remote="github" revision="lineage-21"
           sync-s="true" />

  <!--
    Common MediaTek SELinux policy pulled in by device/vivo/1907N/BoardConfig.mk.
    LineageOS/android_device_mediatek_sepolicy_vndr has a real lineage-21 branch upstream,
    same as it did for lineage-20 - no community fork needed.
  -->
  <project path="device/mediatek/sepolicy_vndr"
           name="LineageOS/android_device_mediatek_sepolicy_vndr"
           remote="github"
           revision="lineage-21" />
</manifest>
